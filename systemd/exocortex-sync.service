[Unit]
Description=Exocortex search index and vector embedding sync worker
Documentation=https://github.com/misty-step/exocortex

[Service]
Type=oneshot
# qmd embed can exceed the 90s default; the write lock must span embed.
TimeoutStartSec=infinity
Environment="PATH=%h/.local/share/mise/shims:%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/exocortex sync
StandardOutput=journal
StandardError=journal
